# Copy to prwatch.env (git-ignored) and fill in. compose.yaml loads it into the container.
# The repository to watch, owner/name, and the branch pull requests land on.
PRWATCH_REPO=example-org/example-repo
PRWATCH_BASE_BRANCH=main
# Your GitHub logins, comma separated: PRs you author are "mine", reviews requested from these are "asked".
PRWATCH_ME=your-login
# Optional: the gh account set-token.ps1 takes GH_TOKEN from (gh auth token -u <this>).
PRWATCH_GH_USER=
# Optional: a reviewer requested on your PRs once they are ready and CI cleared. Empty = never request.
PRWATCH_REVIEWER=
# Optional: a check name prefix that must have passed before any model call. Empty = none.
PRWATCH_REQUIRED_CHECK=
# Model calls per day and per PR per day; 0 = no cap.
PRWATCH_DAILY_CAP=6
PRWATCH_PER_PR_CAP=2
# 1 = post APPROVE when the rules allow it; 0 = comments only.
PRWATCH_ALLOW_APPROVE=0
