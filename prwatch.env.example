# Copy to prwatch.env (git-ignored) and fill in. compose.yaml loads it into the container.
# The repository to watch, owner/name, and the branch pull requests land on.
PRWATCH_REPO=example-org/example-repo
PRWATCH_BASE_BRANCH=main
# Your GitHub logins, comma separated: PRs you author are "mine", reviews requested from these are "asked".
PRWATCH_ME=your-login
# Optional: the gh account set-token.ps1 takes GH_TOKEN from (gh auth token -u <this>).
PRWATCH_GH_USER=
# Optional: a reviewer requested on your PRs once they are ready and CI cleared. Empty = never request.
PRWATCH_REVIEWER=
# Optional: a check name prefix that must have passed before any model call. Empty = none.
PRWATCH_REQUIRED_CHECK=
# Minutes a re-review waits for the head to stay unchanged, so several fix-up pushes cost one review.
# An explicit re-request skips the wait. 0 = no wait.
PRWATCH_SETTLE_MIN=30
# PRs whose title contains one of these (comma separated, any case) are ignored completely.
PRWATCH_SKIP_TITLE=
# claude stops a run at this spend (its own list-price estimate); 0 = no limit.
PRWATCH_MAX_RUN_USD=25
# Seconds between polls (one GraphQL read of the open PRs each).
PRWATCH_INTERVAL=180
# 1 = post REQUEST_CHANGES when code counts a critical finding; 0 = such reviews post as COMMENT.
PRWATCH_ALLOW_REQUEST_CHANGES=0
# After this many change requests from you on one PR, new commits stop starting re-reviews; the author
# gets one comment and a re-request still works. 0 = no limit.
PRWATCH_MAX_CHANGE_ROUNDS=5
# The reviewer subagent runs on this model for a diff of at most PRWATCH_SMALL_PR_MAX_LINES added plus
# removed lines that touches no path matching PRWATCH_RISKY_PATHS (regex). Empty = always Opus.
PRWATCH_REVIEWER_MODEL_SMALL=sonnet
PRWATCH_SMALL_PR_MAX_LINES=400
# PRWATCH_RISKY_PATHS=^deploy/|^\.github/workflows/|schema\.sql$|/migrations?/|/main\.py$
# The project brain: a vault in the _CONVENTIONS format (MANIFESTs, typed folders, frontmatter).
# Its host folder goes in a compose .env as PRWATCH_BRAIN_HOST=...; empty PRWATCH_BRAIN_DIR = no grounding.
PRWATCH_BRAIN_DIR=/brain
# Vault leaves copied into a review: those naming a changed file, its directory or its package.
PRWATCH_BRAIN_MAX_LEAVES=12
# Model calls per day and per PR per day; 0 = no cap.
PRWATCH_DAILY_CAP=6
PRWATCH_PER_PR_CAP=2
# 1 = post APPROVE when the rules allow it; 0 = comments only.
PRWATCH_ALLOW_APPROVE=0
